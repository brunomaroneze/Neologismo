# O site inteiro é servido pelo Django. O Caddy pede e renova o certificado
# TLS sozinho.

{
	# `email` é uma opção GLOBAL do Caddy: dentro do bloco do site o Caddy
	# recusa o arquivo inteiro com "unrecognized directive".
	email {$EMAIL_ACME}
}

{$DOMINIO} {
	encode zstd gzip

	reverse_proxy backend:8000 {
		# O Django precisa destes headers para montar URLs absolutas
		# corretas e para SECURE_PROXY_SSL_HEADER funcionar.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O Caddy anuncia a si mesmo por padrão.
		-Server
	}

	log {
		output stdout
		format console
	}
}
