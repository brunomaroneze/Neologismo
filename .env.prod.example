# Ambiente de PRODUÇÃO (VPS única com docker-compose.prod.yml).
# Copie para .env no servidor e preencha TUDO. Nunca versione o .env real.

# --- Domínio e TLS ---
# Aponte o A/AAAA do DNS para o IP da VPS ANTES de subir: o Caddy só consegue
# emitir o certificado se o domínio já resolver para esta máquina.
DOMINIO=neoscopio.com.br
# E-mail usado no registro Let's Encrypt (avisos de expiração).
EMAIL_ACME=voce@exemplo.com

# --- Banco de dados ---
POSTGRES_USER=neoscopio
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=neoscopio

# --- Django ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Trocar esta chave invalida todas as sessões e tokens existentes.
SECRET_KEY=

# Comece em 3600 (1h). Só suba para 31536000 depois de confirmar que o HTTPS
# está estável — o navegador memoriza a diretiva e não dá para desfazer rápido.
SECURE_HSTS_SECONDS=3600

LOG_LEVEL=INFO

# Tempo de vida, em segundos, do índice de tags/classes que a Home usa para
# montar os filtros. O cache é derrubado a cada escrita em verbete, então o
# TTL é só rede de segurança — subir isso não deixa o filtro desatualizado.
FACETAS_CACHE_TTL=300

# Regra prática: (2 x núcleos) + 1.
GUNICORN_WORKERS=3

# --- E-mail transacional ---
# Usado para confirmar o e-mail no cadastro, recuperar a senha e avisar o
# autor quando o verbete dele é aprovado ou rejeitado.
#
# ATENÇÃO: a confirmação de e-mail é obrigatória. Com EMAIL_HOST vazio os
# envios são descartados e NINGUÉM consegue concluir o cadastro.
#
# Gmail (senha de app, veja DEPLOY.md seção 5):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_HOST_USER=sua.conta@gmail.com
#   EMAIL_HOST_PASSWORD=<senha de app de 16 letras, sem espaços>
#   DEFAULT_FROM_EMAIL=Neoscópio <sua.conta@gmail.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# O remetente precisa ser um endereço de domínio que você autenticou no
# provedor (SPF/DKIM). Sem isso o e-mail vai para spam.
DEFAULT_FROM_EMAIL=Neoscópio <nao-responda@neoscopio.com.br>

# --- Login com Google e Facebook (opcional) ---
# Cada botão só aparece no site com as duas variáveis do provedor
# preenchidas. Como criar as credenciais: DEPLOY.md, seção 5.1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Sentry (monitoramento de erros) ---
# Dois DSNs: o do backend é privado; o do frontend vai para o bundle público
# (é assim que o Sentry funciona no navegador, e um DSN não dá acesso a nada
# além de enviar eventos).
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=production
# 0.0 = só erros, sem tracing de performance.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Opcionais: com os três preenchidos, o build sobe os sourcemaps e os stack
# traces do Sentry apontam para o seu código, não para o bundle minificado.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
