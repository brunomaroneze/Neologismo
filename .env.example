# Variáveis lidas pelo docker-compose. Copie para .env e ajuste os valores.

# --- Banco de dados (Postgres) ---
POSTGRES_USER=admin_neologismo
POSTGRES_PASSWORD=senha123
POSTGRES_DB=banco_neologismo
# Porta publicada no host para acesso externo ao banco (DBeaver, psql, etc.)
DB_PORT=5432

# --- Backend (Django) ---
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Porta publicada no host (mude se 8000 estiver ocupada por outro projeto)
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# URL usada pelo navegador; deve casar com BACKEND_PORT acima.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
