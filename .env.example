# Ambiente de DESENVOLVIMENTO. Copie para .env e ajuste.
#   cp .env.example .env && docker compose up --build

# --- Banco de dados (Postgres) ---
POSTGRES_USER=admin_neologismo
POSTGRES_PASSWORD=senha123
POSTGRES_DB=banco_neologismo
# Porta publicada no host para acesso externo ao banco (DBeaver, psql).
DB_PORT=5432

# --- Backend (Django) ---
DEBUG=True
SECRET_KEY=chave-de-desenvolvimento-nao-use-em-producao
ALLOWED_HOSTS=127.0.0.1,localhost,backend
BACKEND_PORT=8000

# --- E-mail ---
# Em desenvolvimento, deixe EMAIL_HOST vazio: os e-mails são impressos no log
# do backend em vez de enviados. Assim você lê o link de recuperação de senha
# direto no `docker compose logs backend`.
SITE_URL=http://localhost:8000

# --- Sentry (opcional em dev) ---
# Vazio = SDK desligado, nenhuma requisição sai da aplicação.
SENTRY_DSN=
